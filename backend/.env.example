# AICTE Digital Governance Portal - Environment Configuration Template
# Problem Statement 26262 - Regulation Bureau
# NOTE: Replace all placeholder values before deploying to staging/production.

# Application Server
PORT=5000
NODE_ENV=development

# Authentication & Cryptographic Signing Keys
# CRITICAL: In production, generate strong 256-bit+ random secrets (e.g., openssl rand -hex 32)
JWT_SECRET=your-secure-jwt-signing-key-min-32-characters-placeholder
DOC_TOKEN_SECRET=your-secure-doc-token-signing-key-placeholder

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage Limits (bytes)
MAX_DOCUMENT_SIZE_BYTES=26214400 # 25MB

# Advisory AI Service Integration (Optional, falls back to deterministic rule-based analysis)
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Outbound Notification Providers (Optional, in-app notifications are always enabled)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@aicte-india.org
SMTP_PASS=your-smtp-password-placeholder
SMS_GATEWAY_API_KEY=your-nic-sms-gateway-key-placeholder
